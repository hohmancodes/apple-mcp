{
  "name": "personal-apple-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A scoped, read-only Apple MCP server for a private home Mac tunnel.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:calendar": "node scripts/build-calendar.mjs",
    "test": "npm run build && node --test build/tests/*.test.js tests/*.test.mjs",
    "start": "node build/src/index.js --mock",
    "start:apple": "node build/src/index.js --apple --config config.local.json",
    "tunnel": "node scripts/run-tunnel.mjs",
    "service:make": "node scripts/make-launch-agent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
